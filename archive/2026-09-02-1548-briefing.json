  "summaries": [
    {
      "ticker": "AKN",
      "heading": "AuKing supplements Tundulu diamond hole report with mineral estimates",
      "body": "AuKing has lodged a compliance supplement to its 1 September 2026 release on hole 26NH023 at Tundulu, adding visual mineral abundance estimates as required under ASX Compliance Update 04.23. Logged intervals at approximately 368 to 370.5m and 381m show apatite calcite carbonatite with calcite up to ~75%, apatite up to ~10% and pyrite up to ~5%. No mineralisation has been reported, pending assay results, which are expected within 5 to 6 weeks.",
      "document_key": "2924-03130761-2A1694526",
      "url": "https://asx.api.markitdigital.com/asx-research/1.0/file/2924-03130761-2A1694526"
    },
    {
      "ticker": "NXG",
      "heading": "NexGen's CDI count decreases in routine monthly statement",
      "body": "NexGen's Appendix 4A shows CDIs on issue over quoted securities fell by 9,897,131 to 127,774,907 for August 2026, reflecting net transfers between CDIs and shares quoted on the TSX and NYSE. Common shares without CDIs rose by 10,328,797 to 543,162,860, while options on issue declined by 519,999 to 46,908,164. Convertible debentures were unchanged at 39,571,350.",
